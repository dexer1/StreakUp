# Optional canonical production URL used for metadata and social previews.
# Vercel's system URL is used automatically when this value is omitted.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Auth.js session encryption secret. Generate one with: npx auth secret
AUTH_SECRET=replace-with-a-random-secret
# Required for local production-mode runs and trusted reverse proxies.
AUTH_TRUST_HOST=true

# Google OAuth credentials from Google Cloud Console.
# Authorized callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
